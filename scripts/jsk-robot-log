#!/usr/bin/env python3

import argparse
import sys

import rospy
from std_srvs.srv import Trigger

from jsk_robot_log_manager.srv import StartLogging


ANSI_WHITE = "\033[37m"
ANSI_YELLOW = "\033[33m"
ANSI_RED = "\033[31m"
ANSI_RESET = "\033[0m"


def status_line_color(line, success):
    if ": SKIPPED" in line or line == "Overall: PASS with warnings":
        return ANSI_YELLOW
    if ": FAIL" in line or line.startswith("Overall: FAIL"):
        return ANSI_RED
    if ": PASS" in line or line == "Overall: PASS":
        return ANSI_WHITE
    if (
        line.startswith("ROS master: disconnected")
        or line.startswith("hrpsys: disconnected")
        or line.startswith("rosbag: stopped unexpectedly")
        or (
            line.startswith("Neuro ")
            and ": disconnected (required," in line
        )
    ):
        return ANSI_RED
    if (
        line.startswith("Neuro ")
        and (
            ": disconnected (optional," in line
            or " is not reachable " in line
        )
    ):
        return ANSI_YELLOW
    if not success:
        return ANSI_RED
    return ANSI_WHITE


def print_message(message, success):
    use_color = sys.stdout.isatty()
    for line in message.splitlines():
        if use_color:
            color = status_line_color(line, success)
            print("{}{}{}".format(color, line, ANSI_RESET))
        else:
            print(line)


def call_service(service_name, service_type, *args):
    try:
        rospy.wait_for_service(service_name, timeout=5.0)
        response = rospy.ServiceProxy(service_name, service_type)(*args)
    except (rospy.ROSException, rospy.ServiceException) as error:
        print("ERROR: {}".format(error), file=sys.stderr)
        return 1

    print_message(response.message, response.success)
    if hasattr(response, "directory") and response.directory:
        print_message(response.directory, response.success)
    return 0 if response.success else 1


def main():
    parser = argparse.ArgumentParser(
        description="Start, stop, or inspect coordinated robot logging."
    )
    parser.add_argument(
        "--manager",
        default="/jsk_robot_log_manager",
        help="manager node namespace (default: /jsk_robot_log_manager)",
    )
    subparsers = parser.add_subparsers(dest="command")

    start_parser = subparsers.add_parser("start")
    start_parser.add_argument("name", nargs="?", default="session")
    start_parser.add_argument(
        "--duration",
        type=int,
        default=0,
        help="hrpsys buffer duration in seconds (default: node setting)",
    )
    subparsers.add_parser("stop")
    subparsers.add_parser("status")
    subparsers.add_parser(
        "test",
        help=(
            "record for about five seconds, verify non-empty output, "
            "and discard the test data"
        ),
    )

    args = parser.parse_args(rospy.myargv()[1:])
    if args.command is None:
        parser.print_help()
        return 2
    if args.command == "start" and args.duration < 0:
        parser.error("--duration must be zero or greater")

    rospy.init_node("robot_log_client", anonymous=True)
    manager_namespace = "/" + args.manager.strip("/")
    if args.command == "start":
        return call_service(
            manager_namespace + "/start",
            StartLogging,
            args.name,
            args.duration,
        )
    if args.command == "test":
        print("Test running (about 5 seconds)...", flush=True)
    return call_service(
        manager_namespace + "/{}".format(args.command),
        Trigger,
    )


if __name__ == "__main__":
    sys.exit(main())
